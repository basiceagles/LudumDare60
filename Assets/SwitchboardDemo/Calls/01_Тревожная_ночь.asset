%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a28d9b7530256eae7f40d29c8a7c2c1b, type: 3}
  m_Name: 01_Тревожная_ночь
  m_EditorClassIdentifier:
  title: "Тревожная ночь"
  correctDestination: 1
  conversation:
  - speaker: "Незнакомка"
    text: "Здравствуйте… Я снова почти не сплю. За неделю будто ни одной спокойной ночи."
  - speaker: "Незнакомка"
    text: "На работе говорят, что я стала совсем другой. Мысли несутся так быстро, что я не успеваю их закончить."
  - speaker: "Оператор"
    text: "Вы уже обращались с этим к специалисту?"
  - speaker: "Незнакомка"
    text: "Да, меня наблюдали и назначали лекарства. Я потеряла номер врача. Мне нужно вернуться к нему на приём."
  policeReply:
  - speaker: "Дежурный полиции"
    text: "Мы принимаем сообщения о правонарушениях. Здесь человеку нужна связь со своим врачом."
  - speaker: "Незнакомка"
    text: "Нет… Я никого не хотела обвинять. Вы меня не туда соединили."
  psychiatristReply:
  - speaker: "Врач"
    text: "Здравствуйте. Давайте найдём вашу карту и время для приёма."
  - speaker: "Незнакомка"
    text: "Спасибо… Кажется, теперь я попала туда, куда нужно."
  ambulanceReply:
  - speaker: "Диспетчер скорой"
    text: "Эта линия не записывает на консультации к наблюдающему специалисту. Проверьте адрес соединения."
  fireReply:
  - speaker: "Пожарный"
    text: "Вы попали в пожарную службу. В разговоре не было сообщения о возгорании."
  informationReply:
  - speaker: "Справочная"
    text: "Я могу подсказать адрес учреждения, но не соединить с лечащим врачом. Нужна другая линия."
