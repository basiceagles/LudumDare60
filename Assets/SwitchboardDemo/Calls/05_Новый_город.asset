--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a28d9b7530256eae7f40d29c8a7c2c1b, type: 3}
  m_Name: 05_Новый_город
  m_EditorClassIdentifier:
  title: "Новый город"
  correctDestination: 4
  conversation:
  - speaker: "Девушка"
    text: "Добрый вечер! Я недавно переехала и никак не могу найти городскую библиотеку."
  - speaker: "Девушка"
    text: "Мне бы узнать её адрес и до скольких она сегодня открыта. Ничего срочного."
  - speaker: "Оператор"
    text: "Сейчас соединю вас с теми, кто подскажет."
  policeReply:
  - speaker: "Дежурный полиции"
    text: "С адресами и расписанием обычных учреждений поможет городская справочная."
  psychiatristReply:
  - speaker: "Регистратор"
    text: "Вы попали в медицинское учреждение. Для адреса библиотеки нужна справочная."
  ambulanceReply:
  - speaker: "Диспетчер скорой"
    text: "Это линия медицинских вызовов, а не поиска адресов."
  fireReply:
  - speaker: "Пожарный"
    text: "У нас принимают сообщения о пожарах. Соедините абонента со справочной."
  informationReply:
  - speaker: "Справочная"
    text: "Добрый вечер! Назовите район — я подскажу адрес и часы работы библиотеки."
  - speaker: "Девушка"
    text: "Отлично, спасибо. Вот теперь я точно не заблужусь."
