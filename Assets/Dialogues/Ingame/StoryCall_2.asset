--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a28d9b7530256eae7f40d29c8a7c2c1b, type: 3}
  m_Name: StoryCall_2
  m_EditorClassIdentifier: 
  title: Story2
  characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
  correctLineId: psycho
  conversation:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Hello, my friend!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Yes, you! Right now, you're going to be my friend!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: I know you can't answer me, so don't worry. That's not a problem.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Not all friends have to be perfect, you know?
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Sometimes, talking to someone who's your friend is a huge pleasure!
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: I'm John, by the way. You can call me John, I guess!
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: ...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: My parents... they call me stupid. Sometimes they hit me, too.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: They say I'm wasting my life going to school, but... I don't know what
      else I'm supposed to do.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Every evening, I watch the sunset from my balcony. It's really pretty up
      there. The sky turns all orange and pink, and for a little while...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: ...everything feels okay.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: I live on the highest floor, so you can see the whole city from up there.
      The buildings, the lights, all those little people walking around...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: 'It looks so busy from above.


'
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Nobody likes me in the school. Nobody wants to talk to me.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: ...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: But that's okay, right?
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Because I've got you now.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: And talking to you... it helps. It really does. For once, I don't have
      to think about everything that's wrong with my life.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Because I...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: I...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: ...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: 'I''ve never really had a friend before.  '
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Not a real one.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: (You hear a shaky breath from the other end of the line.)
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: S-Sorry. I'm sorry, I didn't mean to...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: (He falls silent for a moment, trying to hold back his tears.)
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Please...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Please don't hang up.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: I know I'm being weird. I know. I'm sorry.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: I'll... I'll do whatever you want, okay? Just...
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: (He struggles to speak through his tears.)
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Just stay with me a little longer.
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: Please...
  ending: {fileID: 11400000, guid: 926198e6b6d77a842aafc19dc0abea50, type: 2}
  policeLineId: police
  policeReply:
  - speaker: John
    characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
    text: (The caller suddenly hangs up.)
  psychiatristLineId: ambulance
  psychiatristReply:
