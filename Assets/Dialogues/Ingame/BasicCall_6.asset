--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a28d9b7530256eae7f40d29c8a7c2c1b, type: 3}
  m_Name: BasicCall_6
  m_EditorClassIdentifier: 
  title: Basic6
  characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
  correctLineId: service
  conversation:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: (You hear mechanical noises in the background.)
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Hey, Johnny! Get away from that thing!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: (You hear the caller pick up the phone again.)
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Oh God, hello! Finally, I got through to you. Sorry for bothering you.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: You're probably pretty busy, so I'm really sorry about that.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: My washing machine broke down today.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: It looks like it's got a mind of its own, so I have no clue what to do!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: (Some water splashes in the background.)
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: God damn it! Now the hose has come loose! Can you connect me with someone
      who can deal with this?!
  ending: {fileID: 0}
  policeLineId: police
  policeReply:
  - speaker: Operator
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Sorry, washing machines aren't under our control. We can't arrest household
      appliances.
  ambulanceLineId: ambulance
  ambulanceReply:
  - speaker: Operator
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Is anyone hurt? If not, there's no need to call an ambulance.
  psychoLineId: psycho
  psychoReply:
  - speaker: ...
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: I understand you've had a tough day. If you'd like, we can talk about it.
  fireLineId: fire
  fireReply:
  - speaker: Operator
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Seriously? A washing machine?
  pizzaLineId: pizza
  pizzaReply:
  - speaker: Habear Pizzeria
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Sorry, we can't help you with that. Have a nice day!
  serviceLineId: service
  serviceReply:
  - speaker: Household Services
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: A plumber is on his way. Could you please tell me your address, ma'am?
  graveyardLineId: hotel
  graveyardReply:
  - speaker: Hotel reception
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Sorry, we can't help you with that. Have a nice day!
  disconnectLineId: disconnect
  disconnectReply: []
  additionalReplies: []
