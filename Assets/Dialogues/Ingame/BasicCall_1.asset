  conversation:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Greetings!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: 'Can anyone hear me? '
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: I'm calling from a payphone at Bluesky Lane!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: And, uhm...
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: ...
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: There should be a pizzeria somewhere around here called...
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: ...
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: H...
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Has...
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Hasbear, right!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: I couldn't find it on my map. Could you help me and connect me?
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Uhm, hello? Did anyone actually hear me?
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
