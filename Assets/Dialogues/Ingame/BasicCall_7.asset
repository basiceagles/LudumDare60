--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a28d9b7530256eae7f40d29c8a7c2c1b, type: 3}
  m_Name: BasicCall_7
  m_EditorClassIdentifier: 
  title: Basic7
  characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
  correctLineId: service
  conversation:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Hey! Hey! I'm on a line? They're killing me! I said, they're killing me!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: In the house across the street!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: My neighbor lives there, you know!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Roxy... Nah! Rihanna! Whatever!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "I\u2019ve lived here for ages"
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: (coughing)
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: and I know everyone!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "But I\u2019ve never seen this guy before."
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "He\u2019s carrying a bag and something\u2019s jingling inside it!"
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "I don\u2019t like him."
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "Oh, I really don\u2019t\u2026"
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "They\u2019re heading into the building!"
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: and flower petals are falling behind them.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "Petals! Red ones! That\u2019s a bad omen - it\u2019s something satanic."
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "I\u2019m telling you!"
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: And she was wearing a fancy dress today.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: I saw her from the window and even wondered what that was all about.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "(A woman\u2019s scream)"
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Do you hear that?!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: 'Do you hear her screaming?! '
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: "Oh my God, they\u2019re killing her! Come quickly!"
  ending: {fileID: 0}
  policeLineId: police
  policeReply:
  - speaker: Operator
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Kill you? With flower petals? Did you know that playing pranks on the police
      is a bad idea?!
  ambulanceLineId: ambulance
  ambulanceReply:
  - speaker: Operator
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Is anyone hurt? If not, there's no need to call an ambulance.
  psychoLineId: psycho
  psychoReply:
  - speaker: ...
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: I understand you've had a tough day. If you'd like, we can talk about it.
  fireLineId: fire
  fireReply:
  - speaker: Operator
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Is this a prank or something?
  pizzaLineId: pizza
  pizzaReply:
  - speaker: Habear Pizzeria
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Sorry, we can't help you with that. Have a nice day!
  serviceLineId: service
  serviceReply: []
  graveyardLineId: hotel
  graveyardReply:
  - speaker: Hotel reception
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Sorry, we can't help you with that. Have a nice day!
  disconnectLineId: disconnect
  disconnectReply: []
  additionalReplies: []
