  title: Basic3
  characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
  correctLineId: service
  conversation:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Good morning!
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Today is a beautiful, sunny day, isn't it?
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: But I've had, uh, some problems recently.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: My kitchen sink is clogged, and I'd like to call someone who could fix
      it.
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: You probably know someone, right?
  ending: {fileID: 0}
  policeLineId: police
  policeReply:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Police? This is some kind of mistake.
  ambulanceLineId: ambulance
  ambulanceReply:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Oh, no, I'm okay! This is some kind of mistake.
  psychoLineId: psycho
  psychoReply:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Uhm... I'm feeling fine, thank you. The sink isn't.
  fireLineId: fire
  fireReply:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: No fire here! Just a lot of water.
  pizzaLineId: pizza
  pizzaReply:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Pizza? Well... maybe later. First, the sink!
  serviceLineId: service
  serviceReply:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: Thanks!
  graveyardLineId: hotel
  graveyardReply:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: A hotel? Uh, it's not that bad yet!
  disconnectLineId: disconnect
  disconnectReply:
  - speaker: Caller
    characterSprite: {fileID: 21300000, guid: e48b250aad4258b41864c8d191a2c3f3, type: 3}
    text: ...
  additionalReplies: []
