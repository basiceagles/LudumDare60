  m_Script: {fileID: 11500000, guid: a28d9b7530256eae7f40d29c8a7c2c1b, type: 3}
  m_Name: EndCall
  m_EditorClassIdentifier: 
  title: EndCall
  characterSprite: {fileID: 21300000, guid: 1620a71ff971cf24fa7799f8db415271, type: 3}
  correctLineId: disconnect
  conversation:
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: Hi
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: I see you're catching up on how things work, right?
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: Okay, so these are your first days as a recaller.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: Your job is simple. You don't need to answer people.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: You're just taking plugs and plugging them into connectors.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: 'A tip: all the services are listed on your right.'
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: You can hang up a call whenever you want, just plug it into the right connector.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: The one without a number.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: The communicator with the connectors is to your right.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: Isn't that simple, right?
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: Oh, also, you might be wondering what that DVD machine in the middle is.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: Like a bull in a china shop.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: It's a punch card machine.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: We rarely use it. So, I'd better not waste my time on that.
  - speaker: Boss
    characterSprite: {fileID: 21300000, guid: 778ae6808b04caa47842c6f1fd932344, type: 3}
    text: I'll call you tonight.
  ending: {fileID: 0}
