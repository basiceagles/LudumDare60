%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9b1906376723fef4e94fede1f6581be3, type: 3}
  m_Name: Ending4
  m_EditorClassIdentifier: 
  mainDialogue:
  - text: Recently, you received a call reporting a bank robbery.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  badEnding:
  - text: Giving in to the robber's threat, you did not pass the report on to law
      enforcement.
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: e4c4dd71b69ffa94ea7d564faa16e048, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: The robbers made off with more than $200,000 and left without harming anyone.
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: e4c4dd71b69ffa94ea7d564faa16e048, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: Hundreds of depositors lost their money.
    textSize: 32
    typeSpeed: 2
    typingClip: {fileID: 8300000, guid: e4c4dd71b69ffa94ea7d564faa16e048, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: 'And they will spend years in court against a bank that will return nothing.

'
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: e4c4dd71b69ffa94ea7d564faa16e048, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: 'We will never know what became of them.

'
    textSize: 32
    typeSpeed: 2
    typingClip: {fileID: 8300000, guid: e4c4dd71b69ffa94ea7d564faa16e048, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  goodEnding:
  - text: Refusing to give in to the robber's threat, you passed the report on to
      law enforcement.
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: ' At 15:46 PM, the police arrived at the building.'
    textSize: 32
    typeSpeed: 2
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: Negotiations began.
    textSize: 32
    typeSpeed: 2
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: At 16 PM, the shooting started.
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 2
    shakeAmount: 2
  - text: 14 bank customers and employees were killed on the spot.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 3
    shakeAmount: 3
  - text: Another 10 died of their wounds in hospital.
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 3
    shakeAmount: 3
  - text: The safe deposit box holders suffered no losses.
    textSize: 32
    typeSpeed: 2
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: The robbery was successfully thwarted.
    textSize: 32
    typeSpeed: 2
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: You did what you were trained to do.
    textSize: 32
    typeSpeed: 2
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: 'Where you work, they call that a job well done.

'
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  forceBadEnding: 0
  forceGoodEnding: 0
