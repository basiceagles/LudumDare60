  m_Name: Ending2
  m_EditorClassIdentifier: 
  mainDialogue:
  - text: 'Recently, you received a call from a person named John.

'
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: 'He was trying to befriend someone and tell them about his troubles.

'
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: e4c4dd71b69ffa94ea7d564faa16e048, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  badEnding:
  - text: At 10:37 AM, the police and medical services responded to a call.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: 'A crowd of people had gathered around.

'
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: A dead body was lying on the ground.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 55be796263426e4458aec8d1f7fd24be, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: Looks like he fell from the highest floor.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 55be796263426e4458aec8d1f7fd24be, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  goodEnding:
  - text: 'After calling for psychological help, John finally found his "friend."

'
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: Something worse didn't happen...
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  forceBadEnding: 0
  forceGoodEnding: 0
