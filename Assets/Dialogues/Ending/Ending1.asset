%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9b1906376723fef4e94fede1f6581be3, type: 3}
  m_Name: Ending1
  m_EditorClassIdentifier: 
  mainDialogue:
  - text: Congrats on getting through your first day!
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: By the way, let's look at the story from a different angle.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: ...
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: e4c4dd71b69ffa94ea7d564faa16e048, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: Recently, you received a call from a man screaming about a fire.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: At 9:47 AM, a house on Brooklyn Avenue caught fire due to poorly maintained
      electrical wiring.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: Within minutes, the flames had spread to at least three neighboring houses.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  badEnding:
  - text: A local resident called 911, but the fire department arrived too late.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: 'In just eight minutes, the remaining houses were engulfed in flames. '
    textSize: 32
    typeSpeed: 5
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: No one had called for help sooner.
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: The incident claimed eight lives.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 55be796263426e4458aec8d1f7fd24be, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 1
    shakeAmount: 1
  - text: Among the victims was the entire Rustypaw family.
    textSize: 32
    typeSpeed: 5
    typingClip: {fileID: 8300000, guid: 55be796263426e4458aec8d1f7fd24be, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 2
    shakeAmount: 2
  - text: They burned alive.
    textSize: 32
    typeSpeed: 3
    typingClip: {fileID: 8300000, guid: 55be796263426e4458aec8d1f7fd24be, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 1
    shakeSpeed: 3
    shakeAmount: 3
  goodEnding:
  - text: Fortunately, a man standing near the payphone immediately called 911.
    textSize: 32
    typeSpeed: 5
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: The fire trucks arrived just in time and successfully extinguished the
      fire.
    textSize: 32
    typeSpeed: 5
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: According to the news, three people suffered burns, but nobody died.
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  - text: Something truly terrible had almost happened...
    textSize: 32
    typeSpeed: 4
    typingClip: {fileID: 8300000, guid: 0f1023c9642bb0b4392fe4f07dfbf056, type: 3}
    typingVolume: 1
    soundEveryCharacters: 1
    shakeLetters: 0
    shakeSpeed: 0
    shakeAmount: 0
  forceBadEnding: 0
  forceGoodEnding: 0
